# Salin file ini menjadi `.env` dan isi dengan nilai milikmu.
# `.env` TIDAK ikut di-commit (lihat .gitignore) — aman untuk rahasia/config lokal.

# Package app Android untuk grouping per activity (mis. com.example.myapp)
ANDROID_APP_PACKAGE=com.example.myapp

# Keyword filter URL default yang tampil di UI (dipisah koma).
# Kosongkan untuk menampilkan semua traffic OkHttp.
URL_FILTER_KEYWORDS=10.10.0.2:5000, api.example.com

# Path biner adb (default: adb dari PATH)
# ADB_PATH=/opt/homebrew/bin/adb

# Port server backend
# PORT=3001
